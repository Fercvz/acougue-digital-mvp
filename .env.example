# A demonstração usa JSON durável se DATABASE_URL ficar vazio.
PORT=3001
DATA_DIR=server/data
DATABASE_URL=
# Use o IP do computador na rede do mercado para abrir QR em outros aparelhos.
# Exemplo: http://192.168.1.50:3000. Também editável na Gestão.
PUBLIC_BASE_URL=http://localhost:3000

# Não habilitar sem conta oficial, templates aprovados e opt-in do cliente.
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_RECEIVED=
WHATSAPP_TEMPLATE_READY=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
